# Containerized test + lint runner. Usage: docker-compose -f docker-compose.test.yml run --rm tests
FROM python:3.14.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
COPY requirements.txt requirements-dev.txt ./
RUN pip install -r requirements.txt -r requirements-dev.txt

COPY . .

CMD ["sh", "-c", "ruff check tests utils/lmp_store.py scripts && mypy && pytest -q"]
